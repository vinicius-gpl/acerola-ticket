{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS do template — um caminho de escrita por dado, SQLite por baixo.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "docs": "cross-env OPEN_DOCS=1 nest start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build -w @template/shared",
    "predev": "npm run build -w @template/shared",
    "pretest": "npm run build -w @template/shared",
    "pretest:e2e": "npm run build -w @template/shared",
    "pretypecheck": "npm run build -w @template/shared",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@template/shared": "*",
    "drizzle-orm": "^0.45.2",
    "nestjs-zod": "^5.5.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@swc/core": "^1.7.35",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jiti": "^2.3.3",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.8.1",
    "unplugin-swc": "^1.5.1",
    "vitest": "^5.0.1"
  }
}
