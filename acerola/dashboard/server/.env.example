# Variáveis do server. Este arquivo é versionado; o `.env` ao lado NUNCA.
#
# ATENÇÃO — isto mudou: antes o banco era um arquivo local e `npm run dev` subia sem `.env`
# nenhum. Agora o banco é o Postgres da Neon e os arquivos vão para o Cloudflare R2, e os
# dois exigem credencial. Sem `.env`, o server recusa subir e diz qual variável falta.
#
# Copie este arquivo para `.env` e troque os valores marcados com <...>.
#
# O que for segredo mora SÓ aqui. O client tem o `.env` dele, e tudo que está lá vira público
# no navegador — a separação é física, não uma regra que alguém precisa lembrar.

# ─────────────────────────────────────────────────────────────────────────────
# Banco — Postgres na Neon
# ─────────────────────────────────────────────────────────────────────────────
# No painel da Neon: o projeto → "Connection string" → copie a de "Pooled connection".
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
#
# As migrations em `server/drizzle/` são aplicadas sozinhas quando o server sobe.
DATABASE_URL=<cole aqui a connection string da Neon>

# O banco que `npm run test:e2e -w server` usa. Precisa ser OUTRO: os testes ESVAZIAM as
# tabelas antes de rodar, e apontar para o banco de trabalho apagaria os dados.
# Na Neon, crie uma branch do banco (Branches → New branch) e use a connection string dela.
# Deixar em branco faz os testes E2E serem pulados, e não falharem.
TEST_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Arquivos — Cloudflare R2
# ─────────────────────────────────────────────────────────────────────────────
# O ID da conta aparece na URL do painel da Cloudflare e no canto do R2.
# O endereço do serviço é montado a partir dele; não existe variável para isso.
R2_ACCOUNT_ID=<id da conta na Cloudflare>

# R2 → "Manage R2 API Tokens" → crie um token com permissão de leitura e escrita no bucket.
# O segredo aparece UMA vez; se perder, gere outro.
R2_ACCESS_KEY_ID=<access key id do token do R2>
R2_SECRET_ACCESS_KEY=<secret access key do token do R2>

# O bucket precisa existir antes. Mantenha-o PRIVADO: o download acontece por link assinado,
# com validade curta, e não por endereço fixo.
R2_BUCKET=<nome do bucket>

# Por quantos segundos um link de download continua valendo. Entre 30 e 3600.
# Curto de propósito: o link dá acesso a quem o tiver, sem passar pela identidade.
R2_SIGNED_URL_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# Login — Neon Auth
# ─────────────────────────────────────────────────────────────────────────────
# Quem autentica as pessoas é o Neon Auth, não esta API. No painel da Neon:
# o projeto → Auth → a URL do endpoint de autenticação. É a MESMA URL do
# VITE_NEON_AUTH_URL do client, sem o prefixo VITE_.
#
# O servidor a usa para buscar a chave pública da Neon e conferir a assinatura
# do token que a tela apresenta. Sem ela, a API não sobe.
NEON_AUTH_URL=<cole aqui a URL do Neon Auth>

# ─────────────────────────────────────────────────────────────────────────────
# API — tudo aqui tem padrão e pode ficar como está
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3005
API_CORS_ORIGIN=http://localhost:5005
API_LOG_LEVEL=debug
