{
  "name": "acerola-bot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "O bot de WhatsApp, isolado num serviço à parte: o servidor só conhece a API HTTP dele.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "pino": "^9.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jiti": "^2.3.3",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
