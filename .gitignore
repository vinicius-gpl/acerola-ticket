node_modules/
dist/
build/
# Exceção: acerola/agent/build/ não é saída de build, é a pasta que o Wails
# usa por convenção pra ícones e manifesto do instalador — código-fonte.
!acerola/agent/build/
coverage/
reports/
.vite/
.tanstack/
.svelte-kit/
storybook-static/
playwright-report/
blob-report/
test-results/
.stryker-tmp/
.eslintcache
*.tsbuildinfo
*.log

.env
.env.*
!.env.example

# Valor falso só para o Vitest carregar em `import.meta.env` — sem ele, o CI (que nunca tem
# um `.env` de verdade) não consegue nem carregar a tela de login para testar o resto.
!acerola/dashboard/client/.env.test

# O banco SQLite local. O que é versionado são as migrations e os seeds, não os dados.
*.db
*.db-wal
*.db-shm
*.db-journal

acerola/dashboard/client/src/lib/api/generated/
acerola/dashboard/client/src/routeTree.gen.ts

.DS_Store
Thumbs.db
desktop.ini
.idea/

# Ajuste local do Claude Code — é de quem programa, não do projeto.
.claude/settings.local.json
